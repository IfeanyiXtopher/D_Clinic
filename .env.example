# Copy to .env and fill in. `.env` is gitignored.
PG_HOST=localhost
PG_PORT=5432
PG_DB=d_clinic
PG_USER=postgres
PG_PASSWORD=change-me

REDIS_URL=redis://localhost:6379/0

# Synthetic cohort
SYNTH_SEED=42
SYNTH_PATIENTS=6000

# LLM (summaries / SMS NLU) and embeddings (ready-reckoner).
# Offline default: no API calls.
# Laptop:  LLM_PROVIDER=ollama  EMBEDDING_PROVIDER=ollama
#          ollama pull qwen2.5:3b && ollama pull nomic-embed-text
# Live VPS: LLM_PROVIDER=openai  EMBEDDING_PROVIDER=openai  OPENAI_API_KEY=sk-...
LLM_PROVIDER=none
EMBEDDING_PROVIDER=tfidf
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# LLM_TIMEOUT_S=30
